{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maniramezan/mobile-testing/docs/amoo-config.schema.json",
  "title": "amoo.config.json",
  "description": "Project configuration for amoo: credential profiles an agent signs in with by reference, screenshot defaults, and opted-in accessibility checks.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "profiles": {
      "type": "object",
      "propertyNames": { "pattern": "^[^#]+$" },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "screenshots": {
      "type": "object",
      "description": "Agent screenshot defaults; a call's own scale or return_image wins. Captures are always saved to a file.",
      "additionalProperties": false,
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Image size relative to one pixel per point (iOS) or dp (Android), for the saved file and any inline image."
        },
        "return_image": {
          "type": "boolean",
          "default": false,
          "description": "Also return the image inline when a take_screenshot call does not say."
        }
      }
    },
    "accessibility": {
      "type": "object",
      "description": "Accessibility checks the project opted in to; check_accessibility runs exactly these. A name left out is opted out. Set by amoo init.",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "object",
          "propertyNames": { "enum": ["names", "target_size", "contrast", "text_clipping", "text_scaling", "traits", "element_detection"] },
          "additionalProperties": { "type": "boolean" }
        },
        "configurations": {
          "type": "object",
          "description": "Display settings the checks are repeated in after the default pass; each is restored afterwards.",
          "propertyNames": { "enum": ["dark_mode", "large_text", "increase_contrast"] },
          "additionalProperties": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["apps", "fields"],
      "additionalProperties": false,
      "properties": {
        "apps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requires_launch_env": {
          "type": "object",
          "description": "Launch environment amoo must have sent; \"*\" means the key only has to be present.",
          "additionalProperties": { "type": "string" }
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[^#]+$" },
          "additionalProperties": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["class"],
      "additionalProperties": false,
      "properties": {
        "class": { "enum": ["identifier", "secret"] },
        "literal": { "type": "string" },
        "env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "An environment variable of the amoo process, read at sign-in."
        },
        "keychain": {
          "type": "object",
          "required": ["service", "account"],
          "additionalProperties": false,
          "properties": {
            "service": { "type": "string", "minLength": 1 },
            "account": { "type": "string", "minLength": 1 }
          }
        }
      },
      "oneOf": [{ "required": ["literal"] }, { "required": ["keychain"] }, { "required": ["env"] }]
    }
  }
}
