--swiftversion 6.0
--indent 4
--linebreaks lf
--maxwidth 120
--trimwhitespace always
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--commas inline
--self remove
--stripunusedargs closure-only
--ifdef no-indent
--disable wrapMultilineStatementBraces

# Never format vendored dependency sources. SPM checkouts live under gitignored build
# directories, so reformatting them is invisible to git but silently corrupts the
# dependency — it previously stripped `: Sendable` conformances out of grpc-swift-2 and
# broke the iOS companion build with errors that appeared to come from the dependency.
# Globs (not just literal paths) so any derived-data location is covered.
--exclude .build,.swiftpm,DerivedData,**/DerivedData,**/SourcePackages,**/checkouts,CompanionApps/iOS/build,CompanionApps/iOS/GeneratedProtos,CompanionApps/Android/build

# SwiftLint's modifier_order wants `nonisolated public`; SwiftFormat defaults to the
# reverse, so the two tools rewrite each other forever. Pin the order SwiftLint expects.
--modifierorder nonisolated,private,fileprivate,internal,public,open,private(set),final
