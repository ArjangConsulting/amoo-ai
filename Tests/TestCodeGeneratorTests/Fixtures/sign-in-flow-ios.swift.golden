import XCTest

/// Generated by amoo from the Studio test "Sign In Flow". Edit freely — this file has no
/// dependency on amoo or the companion apps once generated.
final class SignInFlowTest: XCTestCase {
    func testSignInFlow() throws {
        let app = XCUIApplication()
        app.launch()

        app.descendants(matching: .any)["email-field"].tap()
        app.descendants(matching: .any)["email-field"].tap()
        app.descendants(matching: .any)["email-field"].typeText("user@example.com")
        app.descendants(matching: .any)["sign-in-button"].tap()
        let element_op_4 = app.descendants(matching: .any).matching(NSPredicate(format: "label == %@", "Welcome")).firstMatch
        let predicate_op_4 = NSPredicate(format: "exists == true")
        expectation(for: predicate_op_4, evaluatedWith: element_op_4)
        waitForExpectations(timeout: 5.0)
    }
}