final class _2FALoginTest: XCTestCase {
    func test_2FALogin() throws {
        let app = XCUIApplication()
        app.launch()

        app.descendants(matching: .any)["email-field"].tap()
        app.descendants(matching: .any)["email-field"].tap()
        app.descendants(matching: .any)["email-field"].typeText("user@example.com")
        app.typeText("line one\nline two\ttabbed")
        app.descendants(matching: .any)["list"].swipeUp()
        let element_op_5 = app.descendants(matching: .any)["spinner"]
        let predicate_op_5 = NSPredicate(format: "exists == true")
        expectation(for: predicate_op_5, evaluatedWith: element_op_5)
        waitForExpectations(timeout: 2.0)
        let element_op_6 = app.descendants(matching: .any).matching(NSPredicate(format: "label == %@", "Welcome")).firstMatch
        let predicate_op_6 = NSPredicate(format: "exists == true")
        expectation(for: predicate_op_6, evaluatedWith: element_op_6)
        waitForExpectations(timeout: 5.0)
        let element_op_7 = app.descendants(matching: .any)["spinner"]
        let predicate_op_7 = NSPredicate(format: "exists == false")
        expectation(for: predicate_op_7, evaluatedWith: element_op_7)
        waitForExpectations(timeout: 5.0)
        XCTAssertEqual(app.descendants(matching: .any)["greeting"].label, "Hi there")
        let screenshot_op_9 = XCTAttachment(screenshot: app.screenshot())
        screenshot_op_9.lifetime = .keepAlways
        add(screenshot_op_9)
        app.swipeRight() // press_back: best-effort edge-swipe back gesture
    }
}