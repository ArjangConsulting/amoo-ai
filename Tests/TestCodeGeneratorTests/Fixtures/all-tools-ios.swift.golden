import XCTest

/// Generated by amoo from the Studio test "2FA Login". Edit freely — this file has no
/// dependency on amoo or the companion apps once generated.
final class _2FALoginTest: XCTestCase {
    private let defaultTimeout: TimeInterval = 5

    private func waitForExistence(
        _ element: XCUIElement,
        timeout: TimeInterval? = nil,
        file: StaticString = #filePath,
        line: UInt = #line
    ) {
        XCTAssertTrue(
            element.waitForExistence(timeout: timeout ?? defaultTimeout),
            "Element did not exist before the timeout.\n\(element.debugDescription)",
            file: file,
            line: line
        )
    }

    private func waitForHittability(
        _ element: XCUIElement,
        timeout: TimeInterval? = nil,
        file: StaticString = #filePath,
        line: UInt = #line
    ) {
        XCTAssertTrue(
            element.wait(for: \.isHittable, toEqual: true, timeout: timeout ?? defaultTimeout),
            "Element was not visible and hittable before the timeout.\n\(element.debugDescription)",
            file: file,
            line: line
        )
    }

    private func waitForNonHittability(
        _ element: XCUIElement,
        timeout: TimeInterval? = nil,
        file: StaticString = #filePath,
        line: UInt = #line
    ) {
        XCTAssertTrue(
            element.wait(for: \.isHittable, toEqual: false, timeout: timeout ?? defaultTimeout),
            "Element was still visible and hittable after the timeout.\n\(element.debugDescription)",
            file: file,
            line: line
        )
    }

    func test_2FALogin() throws {
        let app = XCUIApplication()
        app.launch()

        let element_op_1 = app.descendants(matching: .any)["email-field"]
        waitForHittability(element_op_1, timeout: 5.0)
        element_op_1.tap()
        let element_op_2 = app.descendants(matching: .any)["email-field"]
        waitForHittability(element_op_2, timeout: 5.0)
        element_op_2.tap()
        element_op_2.typeText("user@example.com")
        app.typeText("line one\nline two\ttabbed")
        let element_op_4 = app.descendants(matching: .any)["list"]
        waitForHittability(element_op_4, timeout: 5.0)
        element_op_4.swipeUp()
        let element_op_5 = app.descendants(matching: .any)["spinner"]
        waitForExistence(element_op_5, timeout: 2.0)
        let element_op_6 = app.descendants(matching: .any).matching(NSPredicate(format: "label == %@", "Welcome")).firstMatch
        waitForHittability(element_op_6, timeout: 5.0)
        let element_op_7 = app.descendants(matching: .any)["spinner"]
        waitForNonHittability(element_op_7, timeout: 5.0)
        let element_op_8 = app.descendants(matching: .any)["greeting"]
        waitForExistence(element_op_8, timeout: 5.0)
        XCTAssertEqual(element_op_8.label, "Hi there")
        let screenshot_op_9 = XCTAttachment(screenshot: app.screenshot())
        screenshot_op_9.lifetime = .keepAlways
        add(screenshot_op_9)
        app.swipeRight() // press_back: best-effort edge-swipe back gesture
        let element_op_11 = app.descendants(matching: .any)["submit-button"]
        waitForExistence(element_op_11, timeout: 5.0)
        XCTAssertTrue(element_op_11.isEnabled)
        app.swipeUp()
    }
}