{
  "formatVersion": 1,
  "name": "Context Example",
  "description": "Minimal app-owned test context: support module, base class, app factory, harnessLaunchesApp",
  "platform": "iOS",
  "steps": [
    { "id": "step-1", "instruction": "Open Habits and confirm it loaded", "expected": "Habits tab is shown" }
  ],
  "testContext": {
    "imports": ["MyUITestSupport"],
    "baseClass": "MyAppUITestCase",
    "appFactory": "makeTestApplication()",
    "harnessLaunchesApp": true,
    "helpers": [],
    "selectorExpressions": {},
    "idLookupTemplate": null
  },
  "compiledPlan": {
    "compiler": "session-compiler",
    "compilerVersion": "1",
    "toolOperations": [
      { "id": "op-1", "tool": "tap_element", "arguments": { "id": "app.tab.habits" } },
      { "id": "op-2", "tool": "assert_visible", "arguments": { "id": "app.tab.habits" } }
    ]
  }
}
